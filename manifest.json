{
  "schemaVersion": 1,
  "id": "io.github.peterszarvas94.pomodoro",
  "name": "Healthy Pomodoro",
  "version": "2.0.0",
  "author": "Peti",
  "license": "MIT",
  "description": "An evidence-informed focus timer that prompts movement, posture changes, eye rest, and screen-free breaks.",
  "kinds": ["bar-widget"],
  "entryPoints": {"barWidget": "BarWidget.qml"},
  "barWidget": {
    "displayName": "Healthy Pomodoro",
    "description": "Focus timer with gentle movement, posture, and screen-rest prompts.",
    "category": "Health",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "focusMinutes": 25,
      "shortBreakMinutes": 5,
      "longBreakMinutes": 15,
      "longBreakAfter": 4,
      "autoStartBreaks": false,
      "autoStartFocus": false
    },
    "schema": [
      {"key": "focusMinutes", "type": "integer", "label": "Focus minutes", "min": 5, "max": 120, "step": 5, "defaultValue": 25},
      {"key": "shortBreakMinutes", "type": "integer", "label": "Short break minutes", "min": 1, "max": 30, "step": 1, "defaultValue": 5},
      {"key": "longBreakMinutes", "type": "integer", "label": "Long break minutes", "min": 5, "max": 60, "step": 5, "defaultValue": 15},
      {"key": "longBreakAfter", "type": "integer", "label": "Focus sessions before long break", "min": 2, "max": 8, "step": 1, "defaultValue": 4},
      {"key": "autoStartBreaks", "type": "boolean", "label": "Auto-start breaks", "defaultValue": false},
      {"key": "autoStartFocus", "type": "boolean", "label": "Auto-start focus", "defaultValue": false}
    ]
  }
}
